# ─────────────────────────────────────────────
# XEBURE — local environment (VS Code)
# Copy this file to `.env` and fill the values.
#   cp .env.example .env
# Only VITE_* vars reach the browser. Never put
# secrets (client secrets, service keys) here.
# ─────────────────────────────────────────────

# Backend (Supabase / Lovable Cloud) — safe, public values
VITE_SUPABASE_URL="https://dnzcwnjagmuwomjnejob.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRuemN3bmphZ211d29tam5lam9iIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc5NzU1ODUsImV4cCI6MjA5MzU1MTU4NX0.-wayn1VS3F6Px2JKSblEW4UhyerrHG20hh9lpq82rkQ"
VITE_SUPABASE_PROJECT_ID="dnzcwnjagmuwomjnejob"

# Google OAuth — Client ID only (public by design).
# Get it at: Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Leave empty to use the managed Google sign-in provided by the backend.
VITE_GOOGLE_CLIENT_ID=""

# Where Google should send the user back after sign-in (must match the
# "Authorized redirect URI" configured on your OAuth client).
VITE_GOOGLE_REDIRECT_URI="http://localhost:8080/feed"

# NOTE: The Google **Client Secret** must NEVER be placed in this file.
# It is stored server-side in the backend auth settings
# (Backend → Users → Authentication Settings → Sign In Methods → Google).
